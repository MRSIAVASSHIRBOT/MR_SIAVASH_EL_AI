# Required runtime secret. Keep the real value in a secret manager, never Git.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. Empty means no owner is configured.
TELEGRAM_OWNER_IDS=

# Public access is opt-in and limited to the public website knowledge Gateway.
TELEGRAM_PUBLIC_ENABLED=false

EL_AI_ENVIRONMENT=development
EL_AI_STATE_DIR=./data
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
TELEGRAM_RATE_LIMIT_PER_MINUTE=12

# Local Hub integration. Keep the Hub bound to loopback.
# Pairing credentials are stored in the operating-system credential manager.
HUB_API_BASE_URL=http://127.0.0.1:8000
HUB_INTEGRATION_ENABLED=false
HUB_ALLOW_REMOTE=false

# Public-only MR_SIAVASH_AI Gateway and website URL.
SITE_PUBLIC_API_BASE_URL=https://mr-siavash-ai-gateway.mrsiavashirbot.workers.dev
SITE_PUBLIC_WEB_BASE_URL=https://mrsiavasshirbot.github.io/MR_SIAVASH_AI
