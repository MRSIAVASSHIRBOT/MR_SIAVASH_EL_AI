# Required runtime secret. Keep the real value in a secret manager, never Git.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. Empty means no owner is configured.
TELEGRAM_OWNER_IDS=

# Public access is opt-in and limited to the public website knowledge Gateway.
TELEGRAM_PUBLIC_ENABLED=false

EL_AI_ENVIRONMENT=development
EL_AI_STATE_DIR=./data
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
TELEGRAM_RATE_LIMIT_PER_MINUTE=12

# Local Hub integration. Loopback is the default.
# Render's isolated background worker may opt into a bare internal host:port binding only:
# HUB_API_BASE_URL=service-name:port and HUB_ALLOW_RENDER_PRIVATE_NETWORK=true.
# This does not permit public HTTP endpoints or public DNS names.
# Credential storage defaults to the OS vault. Headless deployments may explicitly use
# encrypted_file with a base64-encoded 32-byte key from the host secret manager.
EL_AI_CREDENTIAL_STORE=keyring
EL_AI_CREDENTIAL_ENCRYPTION_KEY=
HUB_API_BASE_URL=http://127.0.0.1:8000
HUB_INTEGRATION_ENABLED=false
HUB_ALLOW_REMOTE=false
HUB_ALLOW_RENDER_PRIVATE_NETWORK=false

# Public-only MR_SIAVASH_AI Gateway and website URL.
SITE_PUBLIC_API_BASE_URL=https://mr-siavash-ai-gateway.mrsiavashirbot.workers.dev
SITE_PUBLIC_WEB_BASE_URL=https://mrsiavasshirbot.github.io/MR_SIAVASH_AI

# Optional Cloudflare Telegram bridge transport. Leave local_polling as default.
TELEGRAM_TRANSPORT=local_polling
TELEGRAM_BRIDGE_URL=
TELEGRAM_BRIDGE_SHARED_SECRET=
TELEGRAM_BRIDGE_TIMEOUT_SECONDS=8
