
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MRSIAVASSHIRBOT/MR_SIAVASH_EL_AI/main/contracts/telegram-business/v1/update.schema.json",
  "title": "Telegram Business normalized event v1",
  "oneOf": [
    { "$ref": "#/$defs/businessConnection" },
    { "$ref": "#/$defs/businessMessage" },
    { "$ref": "#/$defs/deletedBusinessMessages" }
  ],
  "$defs": {
    "connectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "type": { "const": "private" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_reply": { "type": "boolean" },
        "can_read_messages": { "type": "boolean" },
        "can_delete_sent_messages": { "type": "boolean" },
        "can_delete_all_messages": { "type": "boolean" },
        "can_edit_name": { "type": "boolean" },
        "can_edit_bio": { "type": "boolean" },
        "can_edit_profile_photo": { "type": "boolean" },
        "can_edit_username": { "type": "boolean" },
        "can_change_gift_settings": { "type": "boolean" },
        "can_view_gifts_and_stars": { "type": "boolean" },
        "can_convert_gifts_to_stars": { "type": "boolean" },
        "can_transfer_and_upgrade_gifts": { "type": "boolean" },
        "can_transfer_stars": { "type": "boolean" },
        "can_manage_stories": { "type": "boolean" }
      }
    },
    "businessConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "event_type", "connection_id", "business_user_id",
        "user_chat_id", "connected_at", "is_enabled", "rights"
      ],
      "properties": {
        "contract_version": { "const": "telegram-business-event.v1" },
        "event_type": { "const": "business_connection" },
        "connection_id": { "$ref": "#/$defs/connectionId" },
        "business_user_id": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "user_chat_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "connected_at": { "type": "integer", "minimum": 1 },
        "is_enabled": { "type": "boolean" },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "is_bot": { "type": "boolean" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "date", "chat", "sender"],
      "properties": {
        "message_id": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "date": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "chat": { "$ref": "#/$defs/chat" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_from_business_account": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 4096 },
        "caption": { "type": "string", "maxLength": 4096 },
        "media_kind": {
          "type": "string",
          "enum": [
            "animation", "audio", "document", "paid_media", "photo", "sticker",
            "video", "video_note", "voice", "live_photo", "contact",
            "location", "venue", "poll", "dice"
          ]
        }
      },
      "not": { "required": ["text", "caption"] }
    },
    "businessMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "event_type", "connection_id", "message"],
      "properties": {
        "contract_version": { "const": "telegram-business-event.v1" },
        "event_type": { "enum": ["business_message", "edited_business_message"] },
        "connection_id": { "$ref": "#/$defs/connectionId" },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "deletedBusinessMessages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "event_type", "connection_id", "chat", "message_ids"],
      "properties": {
        "contract_version": { "const": "telegram-business-event.v1" },
        "event_type": { "const": "deleted_business_messages" },
        "connection_id": { "$ref": "#/$defs/connectionId" },
        "chat": { "$ref": "#/$defs/chat" },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
        }
      }
    }
  }
}
